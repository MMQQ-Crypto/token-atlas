{
  "name": "token-atlas",
  "version": "1.4.0",
  "description": "本地 AI Token 用量统计桌面应用",
  "main": "desktop/main.cjs",
  "author": "Token Atlas",
  "license": "MIT",
  "repository": {"type":"git","url":"https://github.com/MMQQ-Crypto/token-atlas.git"},
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win portable --x64",
    "pack": "electron-builder --win --dir --x64"
  },
  "devDependencies": { "electron": "45.0.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "local.tokenatlas.desktop",
    "productName": "Token Atlas",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "ui/**/*", "assets/**/*", "extension/**/*", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": true, "signExecutable": false, "icon": "assets/icon.ico" },
    "portable": { "artifactName": "Token-Atlas-${version}-Windows-x64.exe" }
  }
}
