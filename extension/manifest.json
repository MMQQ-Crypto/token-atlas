{
  "manifest_version": 3,
  "name": "Token Atlas 真实用量采集",
  "version": "1.1.0",
  "description": "仅采集国内外 AI 网页响应中明确返回的用量元数据，不估算、不保存对话。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://tongyi.aliyun.com/*",
        "https://chat.qwen.ai/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://yiyan.baidu.com/*",
        "https://yuanbao.tencent.com/*",
        "https://xinghuo.xfyun.cn/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "usage.js",
        "network.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://tongyi.aliyun.com/*",
        "https://chat.qwen.ai/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://yiyan.baidu.com/*",
        "https://yuanbao.tencent.com/*",
        "https://xinghuo.xfyun.cn/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
