    {"matches":["https://chat.deepseek.com/*","https://www.doubao.com/*","https://doubao.com/*","https://www.kimi.com/*","https://kimi.com/*","https://kimi.moonshot.cn/*","https://www.qianwen.com/*","https://qianwen.com/*","https://tongyi.aliyun.com/*","https://chat.qwen.ai/*","https://chatglm.cn/*","https://www.chatglm.cn/*","https://yiyan.baidu.com/*","https://yuanbao.tencent.com/*","https://xinghuo.xfyun.cn/*"],"js":["content.js"],"run_at":"document_start"}
  ]
}
